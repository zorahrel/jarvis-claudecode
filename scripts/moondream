#!/usr/bin/env bash
# moondream — CLI wrapper around Moondream Cloud (vision-local cloud mode).
#
# Usage:
#   moondream <image>                       # short caption
#   moondream <image> -l|--long             # long caption
#   moondream <image> "domanda libera"      # visual query
#   moondream <image> --detect "oggetto"    # bounding boxes
#   moondream <image> --point  "oggetto"    # punti
#   moondream <image> "domanda" --focus "soggetto"  # detect+crop il soggetto, poi
#                                            # query sul ritaglio — USARE per soggetti
#                                            # piccoli in scene ampie/neon (il full-frame
#                                            # confonde il modello)
#   moondream --selftest                     # health check: inferenza di cui si
#                                            # conosce la risposta (exit 0 = vede)
#
# <image> = path locale, http(s) URL, o `-` per leggere base64/dataurl da stdin.
# Output: testo plain su stdout, errori su stderr (exit code != 0).
#
# Backend: Moondream Station locale su http://127.0.0.1:2020 se risponde,
# altrimenti Moondream Cloud con MOONDREAM_API_KEY (env o
# ~/.claude/jarvis/router/.env). Forzabile con MOONDREAM_BACKEND=local|cloud.

set -euo pipefail

MD_LOCAL_URL="${MOONDREAM_LOCAL_URL:-http://127.0.0.1:2020}"

if [[ -z "${MOONDREAM_API_KEY:-}" && -f "$HOME/.claude/jarvis/router/.env" ]]; then
  MOONDREAM_API_KEY="$(grep -E '^MOONDREAM_API_KEY=' "$HOME/.claude/jarvis/router/.env" | head -1 | cut -d= -f2-)"
fi
# PIU' CHIAVI = PIU' CREDITO GRATUITO, ma solo se sono di ORG DIVERSI: i $5
# mensili sono per organizzazione, non per chiave, quindi due chiavi dello
# stesso org non sommano niente (verificato leggendo org_id dal payload JWT).
# MOONDREAM_API_KEY resta la principale; le altre vanno in MOONDREAM_API_KEYS
# separate da virgola e si usano SOLO quando la principale esaurisce il credito
# o viene rifiutata. Non e' bilanciamento: e' una scorta, e si consuma un org
# alla volta cosi' il conto resta leggibile.
if [[ -z "${MOONDREAM_API_KEYS:-}" && -f "$HOME/.claude/jarvis/router/.env" ]]; then
  MOONDREAM_API_KEYS="$(grep -E '^MOONDREAM_API_KEYS=' "$HOME/.claude/jarvis/router/.env" | head -1 | cut -d= -f2-)"
fi

# Il backend si sceglie PRIMA di leggere l'immagine: sapere subito che nessun
# backend e' vivo evita di codificare in base64 un file per poi fallire.
md_local_up() { curl -sS -m 2 -o /dev/null "${MD_LOCAL_URL}/docs" 2>/dev/null; }

# La Station ci mette ~15s a diventare pronta dopo un boot/riavvio di launchd.
# Senza questa attesa `auto` in quella finestra cade sulla cloud — che oggi e'
# revocata — e l'utente si vede un 401 con il backend buono che stava partendo.
# Aspettiamo solo se il servizio esiste davvero: se non e' caricato in launchd
# non c'e' niente da aspettare e si passa subito alla cloud.
md_local_registered() {
  launchctl print "gui/$(id -u)/com.jarvis.moondream" >/dev/null 2>&1
}
# Il daemon esce da solo dopo MOONDREAM_IDLE minuti senza richieste: tiene 5.6GB
# residenti, e lasciarlo caldo per giorni vuol dire pagare un sesto di un Mac da
# 32GB per non rispondere a niente. Uscendo pulito (exit 0 con KeepAlive
# SuccessfulExit=false) launchd NON lo rimette su: tocca a noi riaccenderlo.
md_kick_local() {
  md_local_registered || return 1
  launchctl kickstart "gui/$(id -u)/com.jarvis.moondream" >/dev/null 2>&1 || return 1
  return 0
}
md_wait_local() {
  local deadline=$(( SECONDS + ${MOONDREAM_WAIT:-25} ))
  while (( SECONDS < deadline )); do
    md_local_up && return 0
    sleep 2
  done
  return 1
}

BACKEND="${MOONDREAM_BACKEND:-auto}"
case "$BACKEND" in
  local)
    md_local_up || { md_kick_local; md_wait_local; } || {
      echo "moondream: Station locale non pronta su ${MD_LOCAL_URL} (backend=local forzato)" >&2
      exit 2
    }
    ;;
  cloud) ;;
  auto)
    if md_local_up; then
      BACKEND="local"
    elif md_kick_local && md_wait_local; then
      BACKEND="local"
    else
      BACKEND="cloud"
    fi
    ;;
  *) echo "moondream: MOONDREAM_BACKEND non valido: $BACKEND (local|cloud|auto)" >&2; exit 2 ;;
esac

if [[ "$BACKEND" == "cloud" && -z "${MOONDREAM_API_KEY:-}" ]]; then
  echo "moondream: nessun backend disponibile — Station locale giu' su ${MD_LOCAL_URL} e MOONDREAM_API_KEY non impostata" >&2
  exit 2
fi

if [[ $# -lt 1 ]]; then
  # L'help e' il blocco di commento fino alla prima riga vuota commentata: un
  # range di righe fisso (era `3,12p`) si tronca in silenzio ogni volta che si
  # aggiunge un'opzione, ed e' gia' successo con --selftest.
  sed -n '3,/^#$/p' "$0" | sed 's/^# \{0,1\}//' >&2
  exit 64
fi

# --which: CHI risponderebbe adesso, senza guardare nessuna immagine.
#
# Serve a chi tara delle soglie sulle letture di un modello. Il 16/08 il gate
# visivo di procedural-monsters-demo girava contro moondream2 credendo di
# parlare con Moondream 3 (cloud, chiave revocata dall'08/08): stesso comando,
# stessa CLI, stesso formato di risposta, giudice diverso. Le bande di
# visual-spec.js sono tarate sul jitter di MD3, quindi il verdetto era
# sistematicamente storto senza che nulla fallisse. Un guasto lo si vede; una
# SOSTITUZIONE silenziosa no, se non c'e' un modo di chiedere «chi sei».
if [[ "$1" == "--which" ]]; then
  if [[ "$BACKEND" == "local" ]]; then
    # La Station su /v1/models elenca il CATALOGO, non chi e' caricato: il
    # modello vivo e' quello scritto nel config da chi ha avviato il server.
    CUR=$(python3 -c 'import json,os
p = os.path.expanduser("~/.moondream-station/config.json")
try:
    print(json.load(open(p)).get("current_model", "sconosciuto"))
except Exception:
    print("sconosciuto")' 2>/dev/null)
    echo "backend: local (${MD_LOCAL_URL})"
    echo "modello: ${CUR:-sconosciuto}"
  else
    echo "backend: cloud (api.moondream.ai)"
    echo "modello: moondream-3-preview"
  fi
  exit 0
fi

# --selftest: genera un'immagine nota e verifica che la RISPOSTA sia giusta.
# Un `curl /docs` che torna 200 dice solo che la porta e' aperta — il 16/08/2026
# il server ascoltava su :2020 e falliva ogni inferenza per torch mancante.
# L'unico health check che vale e' un'inferenza di cui si conosce la risposta.
if [[ "$1" == "--selftest" ]]; then
  SELFIMG="$(mktemp -t moondream-selftest.XXXXXX).png"
  trap 'rm -f "$SELFIMG"' EXIT
  python3 - "$SELFIMG" <<'PYEOF' || { echo "moondream selftest: impossibile generare l'immagine (manca Pillow?)" >&2; exit 3; }
import sys
from PIL import Image, ImageDraw
img = Image.new("RGB", (320, 200), "white")
ImageDraw.Draw(img).ellipse((60, 40, 260, 160), fill="red")
img.save(sys.argv[1])
PYEOF
  ANSWER=$("$0" "$SELFIMG" "What color is the shape? Answer with one word." 2>&1) || {
    echo "moondream selftest: inferenza fallita — $ANSWER" >&2
    exit 1
  }
  if [[ "$(printf '%s' "$ANSWER" | tr '[:upper:]' '[:lower:]')" == *red* ]]; then
    echo "moondream selftest OK (backend risponde e vede: '${ANSWER}')"
    exit 0
  fi
  echo "moondream selftest: il backend risponde ma NON vede — atteso 'red', ricevuto '${ANSWER}'" >&2
  exit 1
fi

IMG="$1"; shift || true
MODE="caption"
LENGTH="short"
QUERY=""

FOCUS=""
while [[ $# -gt 0 ]]; do
  case "$1" in
    -l|--long) LENGTH="long"; shift ;;
    --detect)  MODE="detect"; QUERY="${2:-}"; shift 2 ;;
    --point)   MODE="point";  QUERY="${2:-}"; shift 2 ;;
    --focus)   FOCUS="${2:-}"; shift 2 ;;
    *)         MODE="query";  QUERY="$1"; shift ;;
  esac
done

# --focus "subject": small subjects in busy/wide scenes confuse the model —
# detect the subject first, crop it (with margin), then run the query/caption
# on the crop. Two API calls, still ~1.5s total.
if [[ -n "$FOCUS" && -f "${IMG:-}" ]]; then
  BBOX=$("$0" "$IMG" --detect "$FOCUS" | jq -r '.objects[0] // empty | "\(.x_min) \(.y_min) \(.x_max) \(.y_max)"')
  if [[ -n "$BBOX" ]]; then
    CROP="$(mktemp -t moondream-focus.XXXXXX).png"
    trap 'rm -f "$CROP"' EXIT
    read -r X0 Y0 X1 Y1 <<<"$BBOX"
    python3 - "$IMG" "$CROP" "$X0" "$Y0" "$X1" "$Y1" <<'PYEOF'
import sys
from PIL import Image
img = Image.open(sys.argv[1]); W, H = img.size
x0, y0, x1, y1 = (float(v) for v in sys.argv[3:7])
x0, y0, x1, y1 = x0 * W, y0 * H, x1 * W, y1 * H
mx, my = (x1 - x0) * 0.3, (y1 - y0) * 0.3
img.crop((max(0, x0 - mx), max(0, y0 - my), min(W, x1 + mx), min(H, y1 + my))).convert('RGB').save(sys.argv[2])
PYEOF
    IMG="$CROP"
  fi
fi

# Resolve image → data URL or http(s) URL passthrough
if [[ "$IMG" == http://* || "$IMG" == https://* ]]; then
  # Cloud API requires base64; fetch and encode
  TMP=$(mktemp -t moondream.XXXXXX)
  trap 'rm -f "$TMP"' EXIT
  curl -sSL -o "$TMP" "$IMG"
  IMG="$TMP"
elif [[ "$IMG" == "-" ]]; then
  TMP=$(mktemp -t moondream.XXXXXX)
  trap 'rm -f "$TMP"' EXIT
  cat > "$TMP"
  IMG="$TMP"
elif [[ ! -f "$IMG" ]]; then
  echo "moondream: file not found: $IMG" >&2
  exit 66
fi

# UN'IMMAGINE VUOTA NON PRODUCE "non vedo niente": PRODUCE UNA BUGIA.
#
# Misurato il 16/08 su PNG uniformi: "# Global Economic Outlook" (3 volte su 3,
# identico), "# AI and Machine Learning in Healthcare", "# Advanced Topics in
# Quantum Mechanics". Titoli plausibili, sicurissimi, zero pixel dietro. Il
# modello non sbaglia a leggere: genera la continuazione piu' probabile, che e'
# esattamente il suo mestiere. Un'immagine vuota per lui non e' un errore.
#
# Perche' qui e non solo nel daemon del browser: la stessa allucinazione arriva
# da `vis ask`, dagli script di QA e da qualunque cosa chiami questo wrapper.
# La difesa va dove passa OGNI chiamata, altrimenti si protegge un chiamante e
# si lasciano scoperti gli altri.
#
# Soglia MISURATA, non stimata (byte per pixel, PNG uniformi si comprimono a
# nulla): 0.0010 bianco puro · 0.0046 about:blank · 0.0154 example.com, la
# pagina vera piu' spoglia · 0.2960 una landing con grafica. 0.008 sta in mezzo
# ai due casi vicini. Nel dubbio si lascia passare: un falso "vuoto" toglie una
# capacita', un falso "pieno" mente. Disattivabile con MOONDREAM_ALLOW_BLANK=1
# per chi vuole davvero interrogare una tinta piatta.
if [[ "${MOONDREAM_ALLOW_BLANK:-0}" != "1" ]]; then
  BLANK=$(python3 - "$IMG" <<'PYEOF' 2>/dev/null || echo "no"
import sys, os
try:
    from PIL import Image
    with Image.open(sys.argv[1]) as im:
        w, h = im.size
    bpp = os.path.getsize(sys.argv[1]) / max(1, w * h)
    # I JPEG hanno un minimo strutturale di header e tabelle di quantizzazione
    # che li tiene sopra la soglia: il test vale sui formati senza perdita, e
    # su un JPEG si preferisce non dire nulla piuttosto che sbagliare.
    fmt = os.path.splitext(sys.argv[1])[1].lower()
    print("si" if bpp < 0.008 and fmt in (".png", ".webp", ".gif") else "no")
except Exception:
    print("no")
PYEOF
)
  if [[ "$BLANK" == "si" ]]; then
    echo "moondream: IMMAGINE VUOTA — $IMG non contiene nulla da leggere." >&2
    echo "  Nessuna domanda posta al modello: su un'immagine vuota risponderebbe" >&2
    echo "  lo stesso, inventando (misurato). Se e' voluto: MOONDREAM_ALLOW_BLANK=1" >&2
    exit 3
  fi
fi

EXT="${IMG##*.}"
# `${VAR,,}` e' bash 4+, ma `#!/usr/bin/env bash` su macOS puo' risolvere al bash
# 3.2 di sistema (quello in /bin): li' e' un errore di sintassi, e lo script
# moriva con "bad substitution" invece di guardare l'immagine. tr e' portabile.
EXT_LC=$(printf '%s' "$EXT" | tr '[:upper:]' '[:lower:]')
case "$EXT_LC" in
  jpg|jpeg) MIME="image/jpeg" ;;
  png)      MIME="image/png" ;;
  gif)      MIME="image/gif" ;;
  webp)     MIME="image/webp" ;;
  *)        MIME="image/jpeg" ;;
esac

B64=$(base64 < "$IMG" | tr -d '\n')
DATAURL="data:${MIME};base64,${B64}"

case "$MODE" in
  caption)
    PAYLOAD=$(printf '{"image_url":"%s","length":"%s","stream":false}' "$DATAURL" "$LENGTH")
    ENDPOINT="/v1/caption"
    JQFILTER='.caption // .error // "(empty)"'
    ;;
  query)
    Q_ESC=$(printf '%s' "$QUERY" | python3 -c 'import json,sys;print(json.dumps(sys.stdin.read()))')
    PAYLOAD=$(printf '{"image_url":"%s","question":%s,"stream":false}' "$DATAURL" "$Q_ESC")
    ENDPOINT="/v1/query"
    JQFILTER='.answer // .error // "(empty)"'
    ;;
  detect)
    Q_ESC=$(printf '%s' "$QUERY" | python3 -c 'import json,sys;print(json.dumps(sys.stdin.read()))')
    PAYLOAD=$(printf '{"image_url":"%s","object":%s}' "$DATAURL" "$Q_ESC")
    ENDPOINT="/v1/detect"
    JQFILTER='.'
    ;;
  point)
    Q_ESC=$(printf '%s' "$QUERY" | python3 -c 'import json,sys;print(json.dumps(sys.stdin.read()))')
    PAYLOAD=$(printf '{"image_url":"%s","object":%s}' "$DATAURL" "$Q_ESC")
    ENDPOINT="/v1/point"
    JQFILTER='.'
    ;;
esac

if [[ "$BACKEND" == "local" ]]; then
  RAW=$(curl -sS -w $'\n%{http_code}' -m "${MOONDREAM_TIMEOUT:-180}" -X POST "${MD_LOCAL_URL}${ENDPOINT}" \
    -H "Content-Type: application/json" \
    --data-binary "@-" <<<"$PAYLOAD")
else
  # La principale, poi la scorta. Si passa alla chiave dopo SOLO su un rifiuto
  # di credenziale o di credito (401/402/403/429): un 500 o un timeout sono
  # guasti del servizio, e riprovarli con un'altra chiave brucerebbe il credito
  # di un secondo org per lo stesso motivo.
  md_cloud_call() {
    curl -sS -w $'\n%{http_code}' -m "${MOONDREAM_TIMEOUT:-180}" -X POST "https://api.moondream.ai${ENDPOINT}" \
      -H "X-Moondream-Auth: $1" \
      -H "Content-Type: application/json" \
      --data-binary "@-" <<<"$PAYLOAD"
  }
  RAW=$(md_cloud_call "${MOONDREAM_API_KEY}")
  CODE_TRY="${RAW##*$'\n'}"
  if [[ "$CODE_TRY" =~ ^(401|402|403|429)$ && -n "${MOONDREAM_API_KEYS:-}" ]]; then
    IFS=',' read -r -a MD_SPARE <<< "$MOONDREAM_API_KEYS"
    for k in "${MD_SPARE[@]}"; do
      k="${k//[[:space:]]/}"
      [[ -z "$k" || "$k" == "${MOONDREAM_API_KEY}" ]] && continue
      echo "moondream: chiave principale rifiutata ($CODE_TRY), passo alla scorta" >&2
      RAW=$(md_cloud_call "$k")
      CODE_TRY="${RAW##*$'\n'}"
      [[ "$CODE_TRY" =~ ^(401|402|403|429)$ ]] || break
    done
  fi
fi
HTTP="${RAW##*$'\n'}"
RESP="${RAW%$'\n'*}"

# Un errore dell'API NON deve uscire su stdout come se fosse una didascalia.
# I JQFILTER qui sopra fanno `.caption // .error`, quindi un 401 finiva sullo
# stesso canale di una descrizione, con exit 0 — e l'hook read-image-to-moondream
# tratta "exit 0 + stdout non vuoto" come lettura riuscita: il modello si vedeva
# consegnare la parola "Unauthorized" come CONTENUTO dell'immagine, senza alcun
# modo di accorgersene (08/08/2026, chiave revocata lato server). Gli errori
# vanno su stderr con exit non-zero — che e' anche il contratto dichiarato
# nell'header di questo script — cosi' l'hook cade sul Read nativo di Claude
# invece di negare la lettura.
API_ERR=""
if command -v jq >/dev/null 2>&1; then
  API_ERR=$(jq -r 'if type=="object" then (.error // empty) else empty end' <<<"$RESP" 2>/dev/null || true)
fi
if [[ -n "$API_ERR" ]] || [[ "$HTTP" =~ ^[45] ]]; then
  # Il locale e' su ma questa richiesta e' fallita: la cloud puo' ancora
  # salvarla. Solo in auto — con un backend forzato l'errore resta l'errore.
  if [[ "$BACKEND" == "local" && "${MOONDREAM_BACKEND:-auto}" == "auto" && -n "${MOONDREAM_API_KEY:-}" ]]; then
    RAW=$(curl -sS -w $'\n%{http_code}' -X POST "https://api.moondream.ai${ENDPOINT}" \
      -H "X-Moondream-Auth: ${MOONDREAM_API_KEY}" \
      -H "Content-Type: application/json" \
      --data-binary "@-" <<<"$PAYLOAD")
    HTTP="${RAW##*$'\n'}"
    RESP="${RAW%$'\n'*}"
    API_ERR=""
    if command -v jq >/dev/null 2>&1; then
      API_ERR=$(jq -r 'if type=="object" then (.error // empty) else empty end' <<<"$RESP" 2>/dev/null || true)
    fi
  fi
fi
if [[ -n "$API_ERR" ]] || [[ "$HTTP" =~ ^[45] ]]; then
  echo "moondream: ${API_ERR:-errore HTTP $HTTP} (${BACKEND}${ENDPOINT}, HTTP $HTTP)" >&2
  exit 1
fi

if command -v jq >/dev/null 2>&1; then
  echo "$RESP" | jq -r "$JQFILTER"
else
  echo "$RESP"
fi
