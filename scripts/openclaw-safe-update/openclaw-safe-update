# ---------------------------------------------------------------- utilita'

def log(msg):
    # niente numeri di telefono nei log, neanche dentro un errore riportato da OpenClaw
    line = f"{datetime.datetime.now():%Y-%m-%d %H:%M:%S} {re.sub(r'[+]?[0-9]{9,}', '<num>', str(msg))}"
    print(line, flush=True)
    try:
        LOG.parent.mkdir(parents=True, exist_ok=True)
        with open(LOG, "a") as f:
            f.write(line + "\n")
    except OSError:
        pass


def run(cmd, timeout=120, env=None):
    try:
        p = subprocess.run(cmd, capture_output=True, text=True, timeout=timeout, stdin=subprocess.DEVNULL, env=env)
        return p.returncode, p.stdout, p.stderr
    except subprocess.TimeoutExpired as e:
        out = e.stdout.decode(errors="replace") if isinstance(e.stdout, bytes) else (e.stdout or "")
        return 124, out, f"timeout dopo {timeout} s"
    except OSError as e:
        return 127, "", str(e)


def oc(args, timeout=120):
    return run(["openclaw", *args], timeout)


def parse_json(text):
    text = (text or "").strip()
    starts = [0] + [m.start() + 1 for m in re.finditer(r"\n[\[{]", text)]
    for i in starts:
        try:
            return json.loads(text[i:])
        except ValueError:
            continue
    return None


def oc_json(args, timeout=120):
    rc, out, _ = oc(args, timeout)
    d = parse_json(out)
    return d if isinstance(d, (dict, list)) else None


def tail(text, n=160):
    lines = [x for x in (text or "").strip().splitlines() if x.strip()]
    return (lines[-1] if lines else "")[:n]


def vtuple(v):
    return tuple(int(x) for x in re.findall(r"\d+", v or ""))


def short(v):
    return re.sub(r"^\d{4}\.", "", v or "?")


def base(v):
    return re.sub(r"-\d+$", "", v or "")


def sha(path):
    return hashlib.sha256(Path(path).read_bytes()).hexdigest()


def load_state():
    try:
        return json.loads(STATE.read_text())
    except (OSError, ValueError):
        return {}


def save_state(state):
    STATE.parent.mkdir(parents=True, exist_ok=True)
    STATE.write_text(json.dumps(state, indent=1, ensure_ascii=False) + "\n")


# ---------------------------------------------------------------- OpenClaw: stato

def installed_version():
    _, out, _ = oc(["--version"], 60)
    m = re.search(VER_RE, out)
    return m.group(0) if m else None


def gateway_pid():
    _, out, _ = run(["launchctl", "print", f"gui/{os.getuid()}/{LABEL}"], 30)
    m = re.search(r"^\s*pid = (\d+)", out, re.M)
    return int(m.group(1)) if m else None


def gateway_up():
    return bool(((oc_json(["gateway", "status", "--json"], 90) or {}).get("rpc") or {}).get("ok"))


def ancestors():
    pids, pid = set(), os.getpid()
    while pid > 1 and pid not in pids:
        pids.add(pid)
        _, out, _ = run(["ps", "-o", "ppid=", "-p", str(pid)], 10)
        pid = int(out.strip() or 0)
    return pids


def plugin_list():
    d = oc_json(["plugins", "list", "--json"], 180) or {}
    return {p.get("id"): p for p in d.get("plugins") or []}


def pinned(spec):
    m = re.search(rf"(?<=.)@({VER_RE})$", spec or "")
    return m.group(1) if m else None


def plugin_ok(pv, core):
    # un core di correzione (2026.9.7-2) usa i plugin della sua coorte (2026.9.7): docs updating.md
    return pv in (core, base(core))


def misaligned(plugins, core):
    """{id: pacchetto} dei plugin che vanno riallineati a `core` a mano: whatsapp e ogni plugin
    globale con un pin esatto (OpenClaw allinea da solo quelli non fissati, tiene i pin esatti)."""
    todo = {}
    for pid, p in sorted(plugins.items()):
        spec = (p.get("trust") or {}).get("installSpec") or ""
        if (pid == PLUGIN or (p.get("origin") == "global" and pinned(spec))) and not plugin_ok(p.get("version"), core):
            todo[pid] = re.sub(r"(?<=.)@[^@/]*$", "", spec) or f"@openclaw/{pid}"
    return todo


def mcp_lazy(cmd):
    rc, out, err = run([MCP_LAZY, cmd], 120)
    return rc, tail(out or err)


def announce_fix(cmd):
    rc, out, err = run([ANNOUNCE_FIX, cmd], 120)
    return rc, tail(out or err)


def jsonl_last_ts(path):
    """Epoch dell'ultima riga della coda che ha un 'timestamp'; None se nella coda non ce n'e'.
    Le righe senza timestamp sono contabilita' (last-prompt, cost-state), non lavoro."""
    try:
        with open(path, "rb") as f:
            size = f.seek(0, 2)
            f.seek(max(0, size - JSONL_TAIL))
            lines = f.read().split(b"\n")
    except OSError:
        return None
    if size > JSONL_TAIL:
        lines = lines[1:]  # la prima riga della coda e' tagliata a meta'
    for ln in reversed(lines):
        try:
            ts = json.loads(ln).get("timestamp")
            return datetime.datetime.fromisoformat(ts.replace("Z", "+00:00")).timestamp()
        except (ValueError, AttributeError, TypeError):
            continue
    return None


def transcript_age():
    """Secondi dall'ultimo evento di un transcript di OpenClaw: SQLite, claude-cli, codex.
    Per i .jsonl conta l'ultima riga con timestamp, non l'mtime: una sessione claude-cli
    parcheggiata da OpenClaw riceve righe di contabilita' senza timestamp ~10 min dopo il suo turno,
    quando OpenClaw la chiude (01/10 00:15, sessione dell'heartbeat), e con l'mtime quella chiusura
    sembrava lavoro e ha interrotto un update vero. L'mtime resta solo se la coda non ha timestamp."""
    newest = 0.0
    for db in glob.glob(str(OC_HOME / "agents/*/agent/openclaw-agent.sqlite")):
        try:
            con = sqlite3.connect(f"file:{db}?mode=ro", uri=True, timeout=5)
            ms = con.execute("select max(created_at) from transcript_events").fetchone()[0]
            con.close()
            newest = max(newest, (ms or 0) / 1000)
        except sqlite3.Error:
            pass
    slug = re.sub(r"[^A-Za-z0-9]", "-", str(HOME))  # come Claude Code nomina ~/.claude/projects
    files = []
    for pat in (HOME / ".claude/projects" / f"{slug}--openclaw*" / "*.jsonl",
                OC_HOME / "agents/*/agent/codex-home/sessions/*/*/*/*.jsonl"):
        for f in glob.glob(str(pat)):
            try:
                files.append((os.path.getmtime(f), f))
            except OSError:
                pass
    # l'ultimo evento non e' mai dopo l'ultima scrittura: si leggono solo le code che possono vincere
    for mtime, f in sorted(files, reverse=True):
        if mtime <= newest:
            break
        ts = jsonl_last_ts(f)
        newest = max(newest, mtime if ts is None else ts)
    return time.time() - newest


def busy_reasons(down_ok=False):
    """Lista vuota = OpenClaw fermo. Altrimenti perche' non lo e'.
    down_ok: un gateway che non risponde conta come fermo. Vale solo dopo un update: non c'e' lavoro
    da interrompere, e aspettare non lo riporta su."""
    h = oc_json(["health", "--json"], 90)
    if not isinstance(h, dict):
        if down_ok and not gateway_up():
            log("il gateway non risponde: nessun lavoro da interrompere")
            return []
        return ["health non risponde"]
    why, n = [], 0
    for st in ("running", "queued"):
        d = oc_json(["tasks", "list", "--json", "--status", st], 90)
        if not isinstance(d, dict):
            why.append("task non leggibili")
            break
        n += len(d.get("tasks") or [])
    if n:
        why.append(f"{n} task attivi")
    runs = sum(int(a.get("activeRuns") or 0) for c in (h.get("channels") or {}).values()
               for a in (c.get("accounts") or {}).values())
    if runs:
        why.append(f"{runs} run in corso sui canali")
    age = transcript_age()
    if age < QUIET_S:
        why.append(f"transcript scritto {int(age)} s fa")
    return why


def wait_idle(minutes, down_ok=False):
    end, polls = time.time() + minutes * 60, 0
    while True:
        why = busy_reasons(down_ok)
        if not why or time.time() >= end:
            return why
        if polls % 10 == 0:
            log("OpenClaw occupato: " + ", ".join(why))
        polls += 1
        time.sleep(POLL_S)


def update_phase():
    return ((oc_json(["update", "status", "--json"], 60) or {}).get("activeRun") or {}).get("phase")


def live_problems(expected):
    """Cosa non va adesso nel gateway in esecuzione (versione, canali, plugin)."""
    gs = oc_json(["gateway", "status", "--json"], 90) or {}
    rpc = gs.get("rpc") or {}
    if not rpc.get("ok"):
        return ["il gateway non risponde"]
    p = []
    ver = (rpc.get("server") or {}).get("version")
    if expected and ver != expected:
        p.append(f"il gateway gira {ver}, attesa {expected}")
    h = oc_json(["health", "--json"], 90) or {}
    if not h.get("ok"):
        p.append("health non ok")
    plug = h.get("plugins") or {}
    for e in plug.get("errors") or []:
        p.append(f"plugin in errore: {str(e.get('id') if isinstance(e, dict) else e)[:60]}")
    if PLUGIN not in (plug.get("loaded") or []):
        p.append("plugin whatsapp non caricato")
    chans = (oc_json(["channels", "status", "--json"], 90) or {}).get("channels") or {}
    for name, c in chans.items():
        if not c.get("configured"):
            continue
        if not c.get("running"):
            p.append(f"{name} fermo")
        elif c.get("connected") is False:
            p.append(f"{name} non connesso")
    wa = chans.get("whatsapp")
    if not wa:
        p.append("whatsapp assente dai canali")
    elif wa.get("healthState") != "healthy" or not wa.get("linked"):
        p.append(f"whatsapp {wa.get('healthState') or 'non healthy'}")
    return p


def doctor_fails():
    _, out, _ = run(["agents-doctor", "--fast"], 180)
    return sorted(x for x in out.splitlines() if x.startswith("FAIL"))


# ---------------------------------------------------------------- OpenClaw: azioni

def kickstart():
    """Riavvio del gateway via launchd (mai bootout). None = tornato su."""
    old = gateway_pid()
    rc, _, err = run(["launchctl", "kickstart", "-k", f"gui/{os.getuid()}/{LABEL}"], 60)
    if rc:
        return f"kickstart: {tail(err)}"
    end = time.time() + KICK_S
    while time.time() < end:
        time.sleep(min(POLL_S, 5))
        pid = gateway_pid()
        if pid and pid != old and gateway_up():
            log(f"gateway riavviato (pid {old} -> {pid})")
            return None
    return f"il gateway non e' tornato su entro {KICK_S:g} s dal kickstart"


def pick_plugin_version(pkg, core):
    """(versione, nota): quella del core se pubblicata, se no la piu' alta compatibile."""
    vs = parse_json(run(["npm", "view", pkg, "versions", "--json"], 90)[1]) or []
    vs = [vs] if isinstance(vs, str) else vs
    for want in dict.fromkeys((core, base(core))):
        if want in vs:
            return want, None
    for v in sorted((v for v in vs if re.fullmatch(VER_RE, v) and vtuple(v) <= vtuple(core)), key=vtuple, reverse=True):
        need = parse_json(run(["npm", "view", f"{pkg}@{v}", "openclaw.compat.pluginApi", "--json"], 90)[1])
        m = re.search(VER_RE, str(need or ""))
        if not m or vtuple(m.group(0)) <= vtuple(core):
            return v, f"{pkg}@{core} non pubblicato, uso {v}"
    return None, f"nessuna versione di {pkg} compatibile con {core}"


def ensure_auto_off(notes):
    # un update puo' riscrivere la config: l'auto-update interno deve restare spento
    _, out, _ = oc(["config", "get", "update.auto.enabled"], 60)
    if out.strip() == "true":
        rc, _, err = oc(["config", "set", "update.auto.enabled", "false"], 60)
        notes.append("auto-update interno rispento" if rc == 0 else f"auto-update: config set fallito ({tail(err)})")


def converge(core, idle_minutes):
    """Plugin fissati e patch MCP a posto per `core`, con un solo riavvio e solo a OpenClaw fermo.
    Ritorna (problemi, note, rimandato). rimandato = serviva un riavvio ma OpenClaw non si e' mai
    fermato: niente riavvio, plugin e patch restano come sono e li sistema il giro dopo."""
    notes = []
    ensure_auto_off(notes)
    plugins = plugin_list()
    if PLUGIN not in plugins:
        return ["plugin whatsapp non trovato"], notes, False
    installs = {}
    for pid, pkg in misaligned(plugins, core).items():
        v, note = pick_plugin_version(pkg, core)
        if note:
            notes.append(note)
        if not v:
            return [note], notes, False
        installs[pid] = f"{pkg}@{v}"
    patch = None
    if mcp_lazy("check")[0]:
        if mcp_lazy("upstream")[0] == 0:
            # fix ufficiale nel codice: niente patch su dist, basta l'opt-in (si ricarica a caldo)
            rc, _, err = oc(["config", "set", "tools.toolSearch", "true"], 60)
            notes.append("fix MCP upstream: tools.toolSearch acceso" if rc == 0 else f"tools.toolSearch: {tail(err)}")
        else:
            patch = "apply"
    announce = announce_fix("check")[0] != 0
    if not (installs or patch or announce):
        return [], notes, False
    busy = wait_idle(idle_minutes, down_ok=True)
    if busy:
        why = f"OpenClaw mai fermo in {idle_minutes:g} min ({', '.join(busy)})"
        log(f"niente riavvio: {why}; plugin e patch MCP li sistema il giro dopo")
        return [], notes + [f"plugin/patch MCP rimandati: {why}"], True
    problems = []
    for spec in installs.values():
        log(f"plugin: openclaw plugins install {spec} --force --pin")
        rc, out, err = oc(["plugins", "install", spec, "--force", "--pin"], 300)
        # l'install a caldo puo' lasciare i canali fermi anche quando esce 1 (30/09 09:44):
        # il kickstart qui sotto parte comunque, subito
        if rc:
            problems.append(f"plugins install {spec}: exit {rc} {tail(err or out)}")
    if patch:
        rc, msg = mcp_lazy("apply")
        if rc:
            problems.append(f"patch MCP: {msg}")
    if announce:
        rc, msg = announce_fix("apply")
        notes.append(f"patch annunci non applicata: {msg}" if rc else "patch annunci applicata")
    err = kickstart()
    if err:
        problems.append(err)
    after = plugin_list()
    for pid, spec in installs.items():
        got, want = (after.get(pid) or {}).get("version"), spec.rsplit("@", 1)[1]
        if got != want:
            problems.append(f"plugin {pid} {got}, atteso {want}")
    if installs and not problems:
        notes.append("plugin -> " + ", ".join(f"{k} {v.rsplit('@', 1)[1]}" for k, v in installs.items()))
    return problems, notes, False


def heartbeat():
    """Un heartbeat vero: modello, tool MCP (con la patch), sessioni. None = andato."""
    d = oc_json(["cron", "list", "--all", "--json"], 90) or {}
    job = next((j for j in d.get("jobs") or [] if j.get("name") == HEARTBEAT), None)
    if not job:
        return f"cron {HEARTBEAT} non trovato"
    t0 = time.time() * 1000 - 2000
    rc, out, err = oc(["cron", "run", job["id"], "--wait", "--wait-timeout", "8m"], 540)
    e = ((oc_json(["cron", "runs", job["id"], "--limit", "1", "--sort", "desc", "--json"], 90) or {})
         .get("entries") or [{}])[0]
    if float(e.get("ts") or 0) < t0:
        return f"heartbeat: nessun run nuovo (exit {rc} {tail(err or out)})"
    error = str(e.get("error") or "")
    if e.get("status") != "ok" and KNOWN_DELIVERY_BUG in error:
        # bug openclaw#153453 (~1 heartbeat su 4 il 30/09, anche su 2026.9.5): il turno e' girato,
        # e' fallita solo la consegna. Non dice niente sulla versione nuova: bocciarla qui la
        # riporterebbe indietro per un difetto che ha anche la vecchia.
        log("heartbeat: turno eseguito, consegna fallita per il bug noto #153453: non conta")
        return None
    if e.get("status") != "ok":
        return f"heartbeat: {e.get('status')} {error[:120]}"
    return None


def health_gate(expected, rec, deferred=False):
    """Problemi NUOVI rispetto alla fotografia di prima: uno gia' rotto non e' colpa dell'update.
    deferred: la patch MCP e' rimandata al giro dopo, quindi la sua assenza e' attesa."""
    before = set(rec.get("problems") or [])
    end = time.time() + SETTLE_S
    while True:
        problems = [x for x in live_problems(expected) if x not in before]
        if not problems or time.time() >= end:
            break
        time.sleep(min(POLL_S, 10))
    if problems:
        return problems
    if not deferred:
        rc, msg = mcp_lazy("check")
        if rc:
            problems.append(f"patch MCP: {msg}")
    hb = heartbeat()
    if hb:
        problems.append(hb)
    new = sorted(set(doctor_fails()) - set(rec.get("doctor") or []))
    if deferred:
        new = [x for x in new if MCP_DOCTOR not in x]
    new = [x for x in new if ANNOUNCE_DOCTOR not in x]  # mai un rollback per lei: vedi ANNOUNCE_FIX
    if new:
        problems.append("agents-doctor: " + "; ".join(new)[:240])
    return problems


def process_table():
    """{pid: (ppid, (avvio, comando))}: l'avvio distingue un pid riusato da quello visto prima."""
    _, out, _ = run(["ps", "-A", "-o", "pid=,ppid=,lstart=,command="], 30)
    table = {}
    for ln in out.splitlines():
        f = ln.split(None, 7)  # pid, ppid, lstart (5 campi), comando
        if len(f) == 8 and f[0].isdigit() and f[1].isdigit():
            table[int(f[0])] = (int(f[1]), (" ".join(f[2:7]), f[7]))
    return table


def descendants(pid):
    table, found, todo = process_table(), {}, [pid]
    while todo:
        parent = todo.pop()
        for child, (ppid, ident) in table.items():
            if ppid == parent and child not in found:
                found[child] = ident
                todo.append(child)
    return found


def kill_orphans(children):
    """Termina i figli dell'update interrotto che gli sono sopravvissuti (il 01/10 un
    update-candidate-state.worker.js era ancora vivo dopo il SIGINT). Solo i pid visti come suoi
    figli, con lo stesso avvio: il run che li possedeva e' morto."""
    end = time.time() + min(POLL_S, 10)  # tempo per uscire da soli
    while True:
        table = process_table()
        alive = {p: i for p, i in children.items() if (table.get(p) or (0, None))[1] == i}
        if not alive or time.time() >= end:
            break
        time.sleep(min(POLL_S, 1))
    for sig in (signal.SIGTERM, signal.SIGKILL):
        for p, ident in alive.items():
            log(f"figlio dell'update interrotto ancora vivo, {sig.name}: pid {p} {ident[1][:120]}")
            try:
                os.kill(p, sig)
            except OSError:
                pass
        end = time.time() + 5
        while alive and time.time() < end:
            time.sleep(0.2)
            table = process_table()
            alive = {p: i for p, i in alive.items() if (table.get(p) or (0, None))[1] == i}
        if not alive:
            return


def reconcile_ledger():
    """Chiude nello storico di OpenClaw un run rimasto `running` col driver morto: un SIGINT arrivato
    prima che l'update installi il suo gestore (01/10 00:18, 32 s dopo l'avvio) lo lascia li', e un
    run attivo blocca il prossimo update e le scritture di config finche' qualcuno non lo chiude.
    Si usa `openclaw update repair` (docs cli/update/repair-and-recovery.md), solo su un run prima
    dell'attivazione: col gateway sano e il driver morto chiude la riga come `failed/abandoned`
    senza Doctor ne' riavvii; un driver vivo lo rifiuta. In ogni altro caso repair ripiega sulla
    finalizzazione completa, che ferma il gateway per il Doctor: OPENCLAW_SERVICE_REPAIR_POLICY=
    external la fa fallire invece di fermarlo (doctor-maintenance salta lo stop del servizio).
    Ritorna True se nessun run resta attivo."""
    st = oc_json(["update", "status", "--json"], 60) or {}
    a = st.get("activeRun")
    if not a:
        return True
    rid = str(a.get("runId") or "?")[:8]
    if a.get("phase") not in PRE_ACTIVATION:
        log(f"run {rid} ancora attivo in fase {a.get('phase')}: non lo tocco")
        return False
    env = dict(os.environ, OPENCLAW_SERVICE_REPAIR_POLICY="external")
    rc, out, err = run(["openclaw", "update", "repair", "--yes", "--json"], 300, env)
    d = parse_json(out)
    d = d if isinstance(d, dict) else {}
    if rc == 0 and not (oc_json(["update", "status", "--json"], 60) or {}).get("activeRun"):
        log(f"storico update: run {rid} chiuso con update repair: {tail(d.get('message') or out)}")
        return True
    log(f"storico update: run {rid} resta attivo, update repair exit {rc}: {tail(err or out)}")
    return False


def clean_update_stages(root, since):
    """Le cartelle .openclaw.update-stage-* che l'update interrotto lascia accanto al pacchetto
    (~730 MB l'una, due il 01/10: OpenClaw non le riprende mai). Solo quelle nate durante questo
    update, e solo dopo che nessun run e' piu' attivo e i suoi figli sono morti."""
    if not root:
        return
    for p in sorted(Path(root).parent.glob(".openclaw.update-stage-*")):
        try:
            st = os.lstat(p)
            if not stat.S_ISDIR(st.st_mode) or st.st_mtime < since:
                continue
            size = tree_bytes(p)
            shutil.rmtree(p)
            log(f"cancellata {p.name} lasciata dall'update interrotto ({size / 1e6:.0f} MB)")
        except OSError as e:
            log(f"{p.name}: non cancellata ({e.strerror or e})")


def after_interrupt(children, started):
    """Dopo il SIGINT: niente figli orfani, niente run appeso nello storico, niente stage."""
    kill_orphans(children)
    if reconcile_ledger():
        root = ((oc_json(["update", "status", "--json"], 60) or {}).get("update") or {}).get("root")
        clean_update_stages(root, started - 5)


def run_update(target, down_ok=False):
    """`openclaw update` verso target. Ritorna (exit, record del run, stderr, interrotto).
    interrotto = perche' OpenClaw si e' svegliato durante la validazione e l'update e' stato fermato
    con SIGINT prima dell'attivazione (docs cli/update/how-updates-run.md: run `failed/interrupted`,
    gateway vecchio intatto). La fase si rilegge per ultima, subito prima del segnale: dopo
    `activating` il gateway e' gia' fermo e interrompere lascerebbe un'installazione a meta'."""
    log(f"openclaw update --yes --json --tag {target}")
    cmd = ["openclaw", "update", "--yes", "--json", "--tag", target, "--timeout", "1800"]
    started = time.time()
    with tempfile.TemporaryFile("w+") as out, tempfile.TemporaryFile("w+") as errf:
        p = subprocess.Popen(cmd, stdout=out, stderr=errf, stdin=subprocess.DEVNULL, text=True)
        busy, end, children = [], time.time() + 3 * 3600, {}
        while p.poll() is None:
            if time.time() > end:
                p.kill()
                break
            time.sleep(WATCH_S)
            if busy or p.poll() is not None:
                continue
            why = busy_reasons(down_ok)
            if why and update_phase() in PRE_ACTIVATION:
                busy = why
                log("OpenClaw si e' messo a lavorare durante la validazione (" + ", ".join(why)
                    + "): interrompo l'update prima dell'attivazione")
                # i figli dell'update partono detached (update-execution.runtime: setsid): chi sono
                # si vede solo adesso, finche' sono ancora figli suoi
                children = descendants(p.pid)
                p.send_signal(signal.SIGINT)
        rc = p.wait()
        if busy:
            after_interrupt(children, started)
        out.seek(0)
        errf.seek(0)
        stdout, stderr = out.read(), errf.read()
    res = parse_json(stdout) or {}
    if rc == 75:
        # consegnato a un helper gestito: l'esito vero arriva nello storico
        end = time.time() + 3600
        while time.time() < end and (oc_json(["update", "status", "--json"], 60) or {}).get("activeRun"):
            time.sleep(POLL_S)
    rec = res.get("run") if isinstance(res.get("run"), dict) else None
    if rec is None or rc == 75:
        rec = (oc_json(["update", "status", "--json"], 60) or {}).get("lastRun") or {}
    log(f"update: exit {rc}, stato {rec.get('status')} {rec.get('reason') or ''}".rstrip())
    return rc, rec, stderr, busy


def run_reason(rec, err=""):
    parts = [rec.get("reason")] if rec.get("reason") else []
    for s in rec.get("steps") or []:
        for f in s.get("failureFacts") or []:
            parts.append((f.get("message") or "").splitlines()[0] if f.get("message") else "")
    if len(parts) < 2 and tail(err):
        parts.append(tail(err))
    return ": ".join(dict.fromkeys(x for x in parts if x))[:200] or "motivo non riportato"


def record(cur, root):
    dist = Path(root or "") / "dist"
    files = sorted(glob.glob(str(dist / "mcp-http.loopback-runtime-*.mjs")) + glob.glob(str(dist / "mcp-http.schema-*.mjs")))
    plugins = plugin_list()
    return {
        "ts": datetime.datetime.now().strftime("%Y%m%d-%H%M%S"),
        "version": cur,
        "root": root,
        "config_sha256": sha(CONFIG) if CONFIG.exists() else None,
        "dist_sha256": {Path(f).name: sha(f) for f in files},
        "plugins": {k: {"version": p.get("version"), "spec": (p.get("trust") or {}).get("installSpec")}
                    for k, p in plugins.items() if p.get("origin") == "global"},
        "doctor": doctor_fails(),
        "problems": live_problems(cur),
    }


def backup(rec):
    """Database SQLite (quelli che una migrazione cambia) + openclaw.json. None = fatto."""
    d = BACKUPS / rec["ts"]
    d.mkdir(parents=True, exist_ok=True)
    os.chmod(BACKUPS, 0o700)
    agents = sorted(Path(p).parent.parent.name for p in glob.glob(str(OC_HOME / "agents/*/agent/openclaw-agent.sqlite")))
    for args in [["--global"]] + [["--agent", a] for a in agents]:
        rc, out, err = oc(["backup", "sqlite", "create", *args, "--repository", str(d), "--json"], 900)
        if rc:
            return f"backup sqlite {' '.join(args)}: {tail(err or out)}"
    if CONFIG.exists():
        shutil.copy2(CONFIG, d / "openclaw.json")
        os.chmod(d / "openclaw.json", 0o600)
    (d / "record.json").write_text(json.dumps(rec, indent=1, ensure_ascii=False))
    for old in sorted(x for x in BACKUPS.iterdir() if x.is_dir())[:-KEEP_BACKUPS]:
        run(["trash", str(old)], 120)
    log(f"backup: {d} ({', '.join(['global'] + agents)} + openclaw.json)")
    return None


def notify(text):
    job = oc_json(["cron", "get", BRIEF_CRON], 60) or {}
    d = job.get("delivery") or {}
    if not (d.get("channel") and d.get("to")):
        log(f"notifica NON inviata (destinatario non leggibile dal cron {BRIEF_CRON[:8]}): {text}")
        return
    rc, out, err = oc(["message", "send", "--channel", d["channel"], "--target", d["to"], "-m", text, "--json"], 120)
    log(f"notifica {'inviata' if rc == 0 else 'NON inviata (' + tail(err or out) + ')'}: {text}")


# ---------------------------------------------------------------- pulizia di tmp

def tree_bytes(path):
    # come du: blocchi occupati, senza mai seguire i link (os.walk non li segue di default)
    total = 0
    for root, dirs, files in os.walk(path):
        for n in dirs + files:
            try:
                total += os.lstat(os.path.join(root, n)).st_blocks * 512
            except OSError:
                pass
    return total


def build_refs():
    """Testo in cui un plugin installato nominerebbe la sua cartella sorgente: plugins list,
    openclaw.json, npm/projects/*/package.json. None = plugin non leggibili: non si cancella niente."""
    rc, out, _ = oc(["plugins", "list", "--json"], 180)
    if rc or not isinstance(parse_json(out), dict):
        return None
    texts = [out]
    for f in [CONFIG, *glob.glob(str(OC_HOME / "npm/projects/*/package.json"))]:
        try:
            texts.append(Path(f).read_text(errors="replace"))
        except OSError:
            pass
    return "\n".join(texts)


def open_under(dirs):
    """(aperte, ignote): le cartelle sotto cui un processo ha un file aperto (o la cwd), e quelle
    di un lotto su cui lsof non ha dato una risposta leggibile. Le une e le altre si tengono."""
    used, unknown = set(), set()
    for i in range(0, len(dirs), LSOF_BATCH):
        batch = dirs[i:i + LSOF_BATCH]
        args = [x for d in batch for x in ("+D", str(d))]  # +D non segue i link simbolici
        rc, out, err = run(["lsof", "-w", "-F", "n", *args], 60)
        # lsof 4.91 esce 1 sia con file trovati, sia senza, sia per errore (es. un +D sparito nel
        # frattempo: stampa l'usage e rifiuta tutto il lotto). Con -w l'unico segno d'errore e'
        # stderr: se non e' vuoto, o l'rc e' altro (timeout 124, lsof assente 127), il lotto e' ignoto.
        if rc not in (0, 1) or err.strip():
            unknown.update(batch)
            continue
        names = [ln[1:] for ln in out.splitlines() if ln.startswith("n")]
        for d in batch:
            roots = {str(d), os.path.realpath(d)}
            if any(n == r or n.startswith(r + "/") for n in names for r in roots):
                used.add(d)
    return used, unknown


def clean_build_tmp(dry):
    """Cancella le cartelle openclaw-plugin-build-* di ~/.openclaw/tmp piu' vecchie di 6 ore, solo
    se nessun plugin le nomina e nessun processo ci ha file aperti. Mai un link, mai altro in tmp."""
    now, kept, old = time.time(), {}, []
    for p in sorted(BUILD_TMP.glob(BUILD_GLOB)):
        try:
            st = os.lstat(p)
        except OSError:
            continue
        if not stat.S_ISDIR(st.st_mode):  # un link simbolico non e' una cartella: non si segue
            kept.setdefault("non cartelle", []).append(p)
        elif now - st.st_mtime < BUILD_MIN_AGE_S:
            kept.setdefault("recenti", []).append(p)
        else:
            old.append(p)
    if not (old or kept):
        return
    gone = []
    if old:
        refs = build_refs()
        if refs is None:
            log(f"pulizia tmp: plugins list non risponde, non cancello le {len(old)} cartelle di build vecchie")
            return
        for p in old:
            if p.name in refs:
                kept.setdefault("nominate da un plugin", []).append(p)
        old = [p for p in old if p.name not in refs]
        used, unknown = open_under(old)
        kept.setdefault("con file aperti", []).extend(p for p in old if p in used)
        kept.setdefault("con lsof in errore", []).extend(p for p in old if p in unknown)
        gone = [p for p in old if p not in used and p not in unknown]
    freed, errors = 0, []
    for p in gone:
        size = tree_bytes(p)
        if dry:
            freed += size
            continue
        try:
            if stat.S_ISLNK(os.lstat(p).st_mode):  # sostituita da un link dopo il controllo
                continue
            shutil.rmtree(p)  # i link dentro li toglie, non li segue
            freed += size
        except OSError as e:
            errors.append(f"{p.name}: {e.strerror or e}")
    done = len(gone) - len(errors)
    why = ", ".join(f"{len(v)} {k}" for k, v in kept.items() if v)
    log(f"pulizia tmp{' [dry-run]' if dry else ''}: {'cancellerei' if dry else 'cancellate'} {done} cartelle "
        f"{BUILD_GLOB}, {freed / 1e9:.1f} GB {'da liberare' if dry else 'liberati'}"
        + (f"; tenute {why}" if why else "") + (f"; errori {'; '.join(errors)[:200]}" if errors else ""))


# ---------------------------------------------------------------- il giro

def rollback(old, rec):
    """Torna a `old` con `openclaw update --tag` (compatibilita' di schema, riavvio e verifica di
    OpenClaw), solo a OpenClaw fermo. Mai `npm i -g`: salterebbe il rifiuto di uno schema o di una
    config piu' nuovi, che le docs dicono di non aggirare (install/updating/rollback-and-recovery.md).
    Ritorna (problemi, in sospeso): in sospeso = OpenClaw mai fermo, nessun riavvio fatto."""
    log(f"rollback a {old}")
    busy = wait_idle(ROLLBACK_IDLE_MIN, down_ok=True)
    if busy:
        return [f"OpenClaw mai fermo in {ROLLBACK_IDLE_MIN:g} min ({', '.join(busy)})"], True
    rc, run_rec, err, busy = run_update(old, down_ok=True)
    now = installed_version()
    if busy and now != old:
        return [f"OpenClaw si e' messo a lavorare durante la validazione ({', '.join(busy)})"], True
    if now != old:
        return [f"OpenClaw non torna a {old} ({run_reason(run_rec, err)}): installata {now}"], False
    problems, notes, deferred = converge(old, ROLLBACK_IDLE_MIN)
    problems = problems or health_gate(old, rec, deferred)
    root = (oc_json(["update", "status", "--json"], 60) or {}).get("update", {}).get("root") or rec.get("root")
    same = {Path(f).name: sha(f) for f in glob.glob(str(Path(root or "") / "dist/mcp-http.*.mjs"))
            if Path(f).name in rec.get("dist_sha256", {})} == rec.get("dist_sha256")
    log(f"rollback: dist patchato {'identico' if same else 'diverso'} da prima dell'update")
    return problems, False


def finish_rollback(state, rec, why):
    last = state["last"]
    old, new = last["from"], last["to"]
    problems, pending = rollback(old, rec)
    last.update(why=why, after=problems,
                result="rollback-pending" if pending else "rollback-failed" if problems else "rolled-back")
    save_state(state)
    if pending:
        notify(f"OpenClaw {short(new)} non passa i controlli ({why}); rollback a {short(old)} rimandato, "
               f"{problems[0]}: riprovo al prossimo giro o a mano con openclaw-safe-update"[:300])
        return 2
    if problems:
        notify(f"aggiornamento OpenClaw fallito ({why}), rollback NON riuscito: {short(installed_version())} "
               f"installata, {'; '.join(problems)}"[:300])
        return 2
    notify(f"aggiornamento OpenClaw fallito, tornato a {short(old)}: {why}"[:300])
    return 1


def maintain(cur, root, dry, idle):
    """Nessuna versione nuova: patch MCP e plugin fissati devono comunque essere a posto."""
    plugins = plugin_list()
    todo = [f"plugin {k} {plugins[k].get('version')} (core {cur})" for k in misaligned(plugins, cur)]
    rc, msg = mcp_lazy("check")
    if rc:
        todo.append(f"patch MCP: {msg}")
    rc, msg = announce_fix("check")
    if rc:
        todo.append(f"patch annunci: {msg}")
    if not todo:
        return 0
    log("da sistemare: " + "; ".join(todo))
    if dry:
        log("dry-run: non tocco niente")
        return 0
    rec = record(cur, root)
    problems, notes, deferred = converge(cur, idle)
    if deferred:
        log("riprovo la notte prossima")
        return 0
    problems = (problems or health_gate(cur, rec)) + [n for n in notes if n.startswith("patch annunci non")]
    if problems:
        notify(f"OpenClaw {short(cur)}: non riesco a sistemare {'; '.join(todo)}: {'; '.join(problems)}"[:300])
        return 1
    notify(f"OpenClaw {short(cur)}: sistemato {'; '.join(todo)}, tutto verde"[:300])
    return 0


def main():
    ap = argparse.ArgumentParser(description="Aggiorna OpenClaw a OpenClaw fermo, con rollback.")
    ap.add_argument("--dry-run", action="store_true", help="passi 1-3 senza toccare niente, poi il piano")
    ap.add_argument("--force-version", help="giro supervisionato verso questa versione (arma il notturno)")
    ap.add_argument("--idle-wait", type=float, default=45, help="minuti di attesa di OpenClaw fermo")
    a = ap.parse_args()

    LOCK.parent.mkdir(parents=True, exist_ok=True)
    lock = open(LOCK, "w")
    try:
        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except OSError:
        log("un altro giro e' in corso: esco")
        return 3

    gw = gateway_pid()
    if (gw and gw in ancestors()) or os.environ.get("OPENCLAW_GATEWAY_SERVICE_PID"):
        # e' esattamente il managed-service-preflight che ha fatto fallire l'auto-update:
        # dall'albero del gateway `openclaw update` non puo' fermare il gateway che lo contiene
        log(f"rifiuto: giro dentro il gateway di OpenClaw (pid {gw}); va lanciato da launchd o da un terminale")
        return 4

    # ogni notte, anche senza update, e prima del controllo del disco: gli avanzi di build da soli
    # bastavano a bloccare l'update. Solo --dry-run si limita a dire cosa cancellerebbe.
    clean_build_tmp(a.dry_run)

    state = load_state()
    armed = bool(state.get("armed"))
    dry = a.dry_run or not (armed or a.force_version)
    st = oc_json(["update", "status", "--json", "--timeout", "15"], 90)
    cur = installed_version()
    if not isinstance(st, dict) or not cur:
        log("OpenClaw non risponde a update status/--version: niente da fare stanotte")
        return 1
    root = (st.get("update") or {}).get("root")
    latest = (st.get("availability") or {}).get("latestVersion")
    last = state.get("last") or {}
    if st.get("activeRun"):
        ar = st["activeRun"]
        log(f"storico update: run {str(ar.get('runId'))[:8]} ancora {ar.get('status')} in fase {ar.get('phase')}"
            + (" (dry-run: non lo tocco)" if dry else ""))
        if not dry:
            reconcile_ledger()

    if last.get("result") == "rollback-pending" and cur == last.get("to"):
        log(f"rollback a {last.get('from')} in sospeso dal giro {last.get('started')}: {last.get('why')}")
        if a.dry_run:
            log("dry-run: non tocco niente")
            return 0
        try:
            rec = json.loads((BACKUPS / last["started"] / "record.json").read_text())
        except (OSError, ValueError, KeyError):
            rec = {}
        return finish_rollback(state, rec, last.get("why"))

    target = a.force_version or latest
    if a.force_version and not re.fullmatch(VER_RE, target):
        log(f"--force-version {target}: non e' una versione")
        return 4
    if not target or vtuple(target) <= vtuple(cur):
        if a.force_version and vtuple(target) < vtuple(cur):
            log(f"--force-version {target} e' piu' vecchia di {cur}: per tornare indietro openclaw update --tag")
            return 4
        log(f"OpenClaw {cur}: nessuna versione nuova (ultima {latest})")
        return maintain(cur, root, dry, a.idle_wait)
    if not a.force_version and last.get("to") == target and (
            last.get("result") in FAILED_RESULTS or last.get("run_status") == "rolled-back"):
        # riprovarla ogni notte vorrebbe dire un'interruzione dei canali ogni notte
        log(f"salto {target}: il giro {last.get('started')} e' tornato indietro ({last.get('why')}); "
            f"per riprovarla --force-version {target}")
        return maintain(cur, root, dry, a.idle_wait)

    why_dry = " [dry-run]" if a.dry_run else " [non armato: il primo giro vero e' quello supervisionato]" if dry else ""
    log(f"OpenClaw {cur} -> {target}{why_dry}")
    busy = busy_reasons() if dry else wait_idle(a.idle_wait)
    if busy:
        log("OpenClaw non e' fermo: " + ", ".join(busy) + ("" if dry else "; riprovo la notte prossima"))
        if not dry:
            return 0
    rec = record(cur, root)
    log(f"fotografia: {cur}, openclaw.json {str(rec['config_sha256'])[:12]}, "
        + ", ".join(f"{k} {v[:12]}" for k, v in rec["dist_sha256"].items())
        + " | plugin " + ", ".join(f"{k} {v['version']}" for k, v in sorted(rec["plugins"].items()))
        + f" | agents-doctor FAIL {len(rec['doctor'])} | problemi gia' presenti {rec['problems'] or 'nessuno'}")
    if dry:
        pins = sorted(k for k, v in rec["plugins"].items() if k == PLUGIN or pinned(v.get("spec")))
        for step in (f"backup SQLite (global + agenti) e openclaw.json in {BACKUPS}/<ts>",
                     f"openclaw update --yes --json --tag {target} (validazione, riavvio e verifica di OpenClaw);"
                     " se OpenClaw si mette a lavorare durante la validazione, SIGINT prima dell'attivazione",
                     f"plugin fissati {', '.join(pins)} -> {target} (plugins install --force --pin)",
                     "patch MCP: saltata se il fix upstream e' nel codice nuovo, se no openclaw-mcp-lazy.py apply",
                     "patch annunci: openclaw-announce-fix.py apply (se non entra lo annota, niente rollback)",
                     "un kickstart -k solo a OpenClaw fermo (se no rimandato), health gate (canali, WhatsApp,"
                     " heartbeat, patch, agents-doctor)",
                     f"se qualcosa fallisce: rollback a {cur} a OpenClaw fermo e health gate; una riga su WhatsApp ad Attilio"):
            log("piano: " + step)
        return 0

    free = shutil.disk_usage(HOME).free / 1e9
    if free < MIN_FREE_GB:
        msg = f"aggiornamento OpenClaw {short(cur)}→{short(target)} non tentato: {free:.1f} GB liberi sul Mac"
        log(msg)
        notify(msg)
        return 4
    err = backup(rec)
    if err:
        msg = f"aggiornamento OpenClaw {short(cur)}→{short(target)} non tentato: {err}"
        log(msg)
        notify(msg[:300])
        return 1

    state["last"] = {"started": rec["ts"], "from": cur, "to": target}
    save_state(state)
    rc, run_rec, err, busy = run_update(target)
    now = installed_version()
    if busy and now == cur:
        state["last"].update(result="interrupted", why=", ".join(busy))
        save_state(state)
        log(f"update interrotto prima dell'attivazione: {cur} resta, riprovo la notte prossima")
        return 0
    if rc == 0 and now == target:
        problems, notes, deferred = converge(target, POST_IDLE_MIN)
        problems = problems or health_gate(target, rec, deferred)
        if not problems:
            state["last"].update(result="ok", notes=notes)
            if a.force_version and not armed:
                state.update(armed=True, armed_at=datetime.datetime.now().isoformat(timespec="seconds"))
                log("armato: da domani il giro notturno aggiorna da solo")
            save_state(state)
            log(f"aggiornato {cur} -> {target}, tutto verde {notes or ''}".rstrip())
            later = "; plugin e patch MCP al prossimo giro (OpenClaw mai fermo)" if deferred else ""
            later += "".join(f"; {n}" for n in notes if n.startswith("patch annunci non"))
            notify(f"OpenClaw aggiornato {short(cur)}→{short(target)}, tutto verde{later}"[:300])
            return 0
        why = "; ".join(problems)
    elif now == cur:
        # OpenClaw non ha attivato la versione nuova, o e' tornato indietro da solo
        why = run_reason(run_rec, err)
        log(f"update non attivato ({run_rec.get('status')}): {why}")
        problems, _, deferred = converge(cur, POST_IDLE_MIN)
        problems = problems or health_gate(cur, rec, deferred)
        state["last"].update(result="failed", why=why, after=problems, run_status=run_rec.get("status"))
        save_state(state)
        if problems:
            notify(f"aggiornamento OpenClaw fallito ({why}) e {short(cur)} non e' sana: {'; '.join(problems)}"[:300])
            return 2
        notify(f"aggiornamento OpenClaw fallito, tornato a {short(cur)}: {why}"[:300])
        return 1
    else:
        why = run_reason(run_rec, err) if rc else f"installata {now}, attesa {target}"
    log(f"fallito dopo l'update: {why}")
    return finish_rollback(state, rec, why)


if __name__ == "__main__":
    sys.exit(main())
