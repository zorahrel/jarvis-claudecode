#!/usr/bin/env python3
"""openclaw-safe-update: aggiorna OpenClaw di notte, solo a OpenClaw fermo, e torna indietro se non va.

Perche' esiste. L'auto-update interno di OpenClaw falliva ogni notte a `managed-service-preflight`
(4 volte fino al 30/09: l'helper girava dentro l'albero di processi del gateway). Due volte in due
giorni (29/09 12:55, 30/09 09:44) un'operazione sui plugin a OpenClaw acceso ha lasciato tutti i
canali giu' per 3-8 minuti. E ogni update riscrive dist/ e cancella la patch openclaw-mcp-lazy.

Un giro (launchd com.jarvis.openclaw-safe-update, 04:20):
  1. `openclaw update status --json`: niente di nuovo -> esce 0 in silenzio (se patch MCP o plugin
     WhatsApp non sono a posto, li sistema a OpenClaw fermo).
  2. aspetta OpenClaw fermo (0 task, 0 run sui canali, nessun transcript da 120 s) fino a
     --idle-wait minuti; se non si ferma esce 0 e riprova la notte dopo.
  3. fotografa versione, sha256 dei file dist patchati, openclaw.json, plugin, FAIL di
     agents-doctor e problemi gia' presenti; salva i database SQLite e openclaw.json.
  4. `openclaw update --yes --json --tag <v>`: OpenClaw valida la versione nuova su una copia dello
     stato, ferma, sostituisce, riavvia, verifica e se la verifica fallisce torna indietro da solo.
     Senza --no-restart apposta: salterebbe proprio quella verifica e quel rollback, e lascerebbe
     il gateway vecchio a girare su un dist/ gia' sostituito (docs cli/update/how-updates-run.md).
  5-7. plugin WhatsApp alla versione del core e patch MCP, poi un solo kickstart a OpenClaw fermo.
  8. health gate: gateway sulla versione giusta, canali su, WhatsApp healthy, un heartbeat vero
     andato a buon fine, patch MCP attiva, nessun FAIL nuovo in agents-doctor.
  9. se qualcosa dopo il 4 va storto: rollback alla versione di prima e di nuovo health gate.
 10. una riga su WhatsApp ad Attilio, solo se e' cambiato o fallito qualcosa (destinatario letto
     dal cron del brief mattutino, mai scritto qui: il repo e' pubblico).

Armato: finche' un giro con --force-version non e' andato a buon fine, il giro notturno fa solo il
--dry-run. Il primo aggiornamento vero lo guarda Attilio.

Uso:
  openclaw-safe-update                          il giro notturno
  openclaw-safe-update --dry-run                passi 1-3 senza toccare niente, poi il piano
  openclaw-safe-update --force-version 2026.9.7 giro supervisionato verso quella versione
  --idle-wait MIN                               attesa massima di OpenClaw fermo (45)

Exit: 0 niente da fare o fatto · 1 fallito ma tornato indietro · 2 fallito e rollback non
riuscito · 3 un altro giro in corso · 4 rifiutato (dentro il gateway, disco, versione).
"""
import argparse
import datetime
import fcntl
import glob
import hashlib
import json
import os
import re
import shutil
import sqlite3
import subprocess
import sys
import time
from pathlib import Path

HOME = Path.home()
JARVIS = HOME / ".claude/jarvis"
STATE = JARVIS / "state/openclaw-safe-update.json"
LOCK = JARVIS / "state/openclaw-safe-update.lock"
LOG = JARVIS / "logs/openclaw-safe-update.log"
BACKUPS = HOME / ".agents/backups/openclaw-safe-update"
OC_HOME = HOME / ".openclaw"
CONFIG = Path(os.environ.get("OPENCLAW_CONFIG_PATH") or OC_HOME / "openclaw.json")
MCP_LAZY = os.environ.get("OSU_MCP_LAZY") or str(
    Path(__file__).resolve().parent.parent / "openclaw-mcp-lazy/openclaw-mcp-lazy.py")

LABEL = "ai.openclaw.gateway"
BRIEF_CRON = "c34dcc15-c2c1-4c5c-8ffa-51b9054827f1"  # brief-mattutino: il suo delivery e' Attilio
HEARTBEAT = "heartbeat-main"
KNOWN_DELIVERY_BUG = "No active WhatsApp Web listener"
PLUGIN = "whatsapp"
QUIET_S = 120                # nessun transcript da 2 minuti = nessun turno in corso
KEEP_BACKUPS = 3
# Solo la suite li abbassa: in produzione nessuno li passa.
POLL_S = float(os.environ.get("OSU_POLL_S", 30))
SETTLE_S = float(os.environ.get("OSU_SETTLE_S", 300))  # tempo concesso ai canali per tornare su
POST_IDLE_MIN = float(os.environ.get("OSU_POST_IDLE_MIN", 20))
# snapshot di validazione ~2 GB + pacchetto + backup SQLite, col disco al 99% (13 GB liberi il 30/09)
MIN_FREE_GB = float(os.environ.get("OSU_MIN_FREE_GB", 8))

VER_RE = r"\d{4}\.\d+\.\d+(?:-\d+)?"


# ---------------------------------------------------------------- utilita'

def log(msg):
    # niente numeri di telefono nei log, neanche dentro un errore riportato da OpenClaw
    line = f"{datetime.datetime.now():%Y-%m-%d %H:%M:%S} {re.sub(r'[+]?[0-9]{9,}', '<num>', str(msg))}"
    print(line, flush=True)
    try:
        LOG.parent.mkdir(parents=True, exist_ok=True)
        with open(LOG, "a") as f:
            f.write(line + "\n")
    except OSError:
        pass


def run(cmd, timeout=120):
    try:
        p = subprocess.run(cmd, capture_output=True, text=True, timeout=timeout, stdin=subprocess.DEVNULL)
        return p.returncode, p.stdout, p.stderr
    except subprocess.TimeoutExpired as e:
        out = e.stdout.decode(errors="replace") if isinstance(e.stdout, bytes) else (e.stdout or "")
        return 124, out, f"timeout dopo {timeout} s"
    except OSError as e:
        return 127, "", str(e)


def oc(args, timeout=120):
    return run(["openclaw", *args], timeout)


def parse_json(text):
    text = (text or "").strip()
    starts = [0] + [m.start() + 1 for m in re.finditer(r"\n[\[{]", text)]
    for i in starts:
        try:
            return json.loads(text[i:])
        except ValueError:
            continue
    return None


def oc_json(args, timeout=120):
    rc, out, _ = oc(args, timeout)
    d = parse_json(out)
    return d if isinstance(d, (dict, list)) else None


def tail(text, n=160):
    lines = [x for x in (text or "").strip().splitlines() if x.strip()]
    return (lines[-1] if lines else "")[:n]


def vtuple(v):
    return tuple(int(x) for x in re.findall(r"\d+", v or ""))


def short(v):
    return re.sub(r"^\d{4}\.", "", v or "?")


def base(v):
    return re.sub(r"-\d+$", "", v or "")


def sha(path):
    return hashlib.sha256(Path(path).read_bytes()).hexdigest()


def load_state():
    try:
        return json.loads(STATE.read_text())
    except (OSError, ValueError):
        return {}


def save_state(state):
    STATE.parent.mkdir(parents=True, exist_ok=True)
    STATE.write_text(json.dumps(state, indent=1, ensure_ascii=False) + "\n")


# ---------------------------------------------------------------- OpenClaw: stato

def installed_version():
    _, out, _ = oc(["--version"], 60)
    m = re.search(VER_RE, out)
    return m.group(0) if m else None


def gateway_pid():
    _, out, _ = run(["launchctl", "print", f"gui/{os.getuid()}/{LABEL}"], 30)
    m = re.search(r"^\s*pid = (\d+)", out, re.M)
    return int(m.group(1)) if m else None


def ancestors():
    pids, pid = set(), os.getpid()
    while pid > 1 and pid not in pids:
        pids.add(pid)
        _, out, _ = run(["ps", "-o", "ppid=", "-p", str(pid)], 10)
        pid = int(out.strip() or 0)
    return pids


def plugin_state():
    d = oc_json(["plugins", "list", "--json"], 180) or {}
    return next((p for p in d.get("plugins") or [] if p.get("id") == PLUGIN), None)


def plugin_ok(pv, core):
    # un core di correzione (2026.9.7-2) usa i plugin della sua coorte (2026.9.7): docs updating.md
    return pv in (core, base(core))


def mcp_lazy(cmd):
    rc, out, err = run([MCP_LAZY, cmd], 120)
    return rc, tail(out or err)


def transcript_age():
    """Secondi dall'ultima scrittura di un transcript di OpenClaw: SQLite, claude-cli, codex."""
    newest = 0.0
    for db in glob.glob(str(OC_HOME / "agents/*/agent/openclaw-agent.sqlite")):
        try:
            con = sqlite3.connect(f"file:{db}?mode=ro", uri=True, timeout=5)
            ms = con.execute("select max(created_at) from transcript_events").fetchone()[0]
            con.close()
            newest = max(newest, (ms or 0) / 1000)
        except sqlite3.Error:
            pass
    slug = re.sub(r"[^A-Za-z0-9]", "-", str(HOME))  # come Claude Code nomina ~/.claude/projects
    for pat in (HOME / ".claude/projects" / f"{slug}--openclaw*" / "*.jsonl",
                OC_HOME / "agents/*/agent/codex-home/sessions/*/*/*/*.jsonl"):
        for f in glob.glob(str(pat)):
            try:
                newest = max(newest, os.path.getmtime(f))
            except OSError:
                pass
    return time.time() - newest


def busy_reasons():
    """Lista vuota = OpenClaw fermo. Altrimenti perche' non lo e'."""
    why, n = [], 0
    for st in ("running", "queued"):
        d = oc_json(["tasks", "list", "--json", "--status", st], 90)
        if not isinstance(d, dict):
            why.append("task non leggibili")
            break
        n += len(d.get("tasks") or [])
    if n:
        why.append(f"{n} task attivi")
    h = oc_json(["health", "--json"], 90)
    if not isinstance(h, dict):
        why.append("health non risponde")
    else:
        runs = sum(int(a.get("activeRuns") or 0) for c in (h.get("channels") or {}).values()
                   for a in (c.get("accounts") or {}).values())
        if runs:
            why.append(f"{runs} run in corso sui canali")
    age = transcript_age()
    if age < QUIET_S:
        why.append(f"transcript scritto {int(age)} s fa")
    return why


def wait_idle(minutes):
    end, polls = time.time() + minutes * 60, 0
    while True:
        why = busy_reasons()
        if not why or time.time() >= end:
            return why
        if polls % 10 == 0:
            log("OpenClaw occupato: " + ", ".join(why))
        polls += 1
        time.sleep(POLL_S)


def live_problems(expected):
    """Cosa non va adesso nel gateway in esecuzione (versione, canali, plugin)."""
    gs = oc_json(["gateway", "status", "--json"], 90) or {}
    rpc = gs.get("rpc") or {}
    if not rpc.get("ok"):
        return ["il gateway non risponde"]
    p = []
    ver = (rpc.get("server") or {}).get("version")
    if expected and ver != expected:
        p.append(f"il gateway gira {ver}, attesa {expected}")
    h = oc_json(["health", "--json"], 90) or {}
    if not h.get("ok"):
        p.append("health non ok")
    plug = h.get("plugins") or {}
    for e in plug.get("errors") or []:
        p.append(f"plugin in errore: {str(e.get('id') if isinstance(e, dict) else e)[:60]}")
    if PLUGIN not in (plug.get("loaded") or []):
        p.append("plugin whatsapp non caricato")
    chans = (oc_json(["channels", "status", "--json"], 90) or {}).get("channels") or {}
    for name, c in chans.items():
        if not c.get("configured"):
            continue
        if not c.get("running"):
            p.append(f"{name} fermo")
        elif c.get("connected") is False:
            p.append(f"{name} non connesso")
    wa = chans.get("whatsapp")
    if not wa:
        p.append("whatsapp assente dai canali")
    elif wa.get("healthState") != "healthy" or not wa.get("linked"):
        p.append(f"whatsapp {wa.get('healthState') or 'non healthy'}")
    return p


def doctor_fails():
    _, out, _ = run(["agents-doctor", "--fast"], 180)
    return sorted(x for x in out.splitlines() if x.startswith("FAIL"))


# ---------------------------------------------------------------- OpenClaw: azioni

def kickstart():
    """Riavvio del gateway via launchd (mai bootout). None = tornato su."""
    old = gateway_pid()
    rc, _, err = run(["launchctl", "kickstart", "-k", f"gui/{os.getuid()}/{LABEL}"], 60)
    if rc:
        return f"kickstart: {tail(err)}"
    end = time.time() + 180
    while time.time() < end:
        time.sleep(min(POLL_S, 5))
        pid = gateway_pid()
        if pid and pid != old and ((oc_json(["gateway", "status", "--json"], 60) or {}).get("rpc") or {}).get("ok"):
            log(f"gateway riavviato (pid {old} -> {pid})")
            return None
    return "il gateway non e' tornato su entro 180 s dal kickstart"


def pick_plugin_version(pkg, core):
    """(versione, nota): quella del core se pubblicata, se no la piu' alta compatibile."""
    vs = parse_json(run(["npm", "view", pkg, "versions", "--json"], 90)[1]) or []
    vs = [vs] if isinstance(vs, str) else vs
    for want in dict.fromkeys((core, base(core))):
        if want in vs:
            return want, None
    for v in sorted((v for v in vs if re.fullmatch(VER_RE, v) and vtuple(v) <= vtuple(core)), key=vtuple, reverse=True):
        need = parse_json(run(["npm", "view", f"{pkg}@{v}", "openclaw.compat.pluginApi", "--json"], 90)[1])
        m = re.search(VER_RE, str(need or ""))
        if not m or vtuple(m.group(0)) <= vtuple(core):
            return v, f"{pkg}@{core} non pubblicato, uso {v}"
    return None, f"nessuna versione di {pkg} compatibile con {core}"


def ensure_auto_off(notes):
    # un update puo' riscrivere la config: l'auto-update interno deve restare spento
    _, out, _ = oc(["config", "get", "update.auto.enabled"], 60)
    if out.strip() == "true":
        rc, _, err = oc(["config", "set", "update.auto.enabled", "false"], 60)
        notes.append("auto-update interno rispento" if rc == 0 else f"auto-update: config set fallito ({tail(err)})")


def converge(core, idle_minutes, must_restart=False):
    """Plugin WhatsApp e patch MCP a posto per `core`, con al massimo un riavvio a OpenClaw fermo.
    Ritorna (problemi, note). must_restart: riavvia anche se OpenClaw non si ferma (rollback)."""
    notes = []
    ensure_auto_off(notes)
    p = plugin_state()
    if not p:
        return ["plugin whatsapp non trovato"], notes
    install = None
    if not plugin_ok(p.get("version"), core):
        spec = (p.get("trust") or {}).get("installSpec") or "@openclaw/whatsapp"
        pkg = re.sub(r"(?<=.)@[^@/]*$", "", spec)
        v, note = pick_plugin_version(pkg, core)
        if note:
            notes.append(note)
        if not v:
            return [note], notes
        install = f"{pkg}@{v}"
    patch_rc, patch_msg = mcp_lazy("check")
    patch = None
    if patch_rc:
        if mcp_lazy("upstream")[0] == 0:
            # fix ufficiale nel codice: niente patch su dist, basta l'opt-in (si ricarica a caldo)
            rc, _, err = oc(["config", "set", "tools.toolSearch", "true"], 60)
            notes.append("fix MCP upstream: tools.toolSearch acceso" if rc == 0 else f"tools.toolSearch: {tail(err)}")
        else:
            patch = "apply"
    if not (install or patch or must_restart):
        return [], notes
    busy = wait_idle(idle_minutes)
    if busy and not must_restart:
        return [f"OpenClaw mai fermo in {idle_minutes:g} min ({', '.join(busy)})"], notes
    problems = []
    if install:
        log(f"plugin: openclaw plugins install {install} --force --pin")
        rc, out, err = oc(["plugins", "install", install, "--force", "--pin"], 300)
        # l'install a caldo puo' lasciare i canali fermi anche quando esce 1 (30/09 09:44):
        # il kickstart qui sotto parte comunque, subito
        if rc:
            problems.append(f"plugins install {install}: exit {rc} {tail(err or out)}")
    if patch:
        rc, msg = mcp_lazy("apply")
        if rc:
            problems.append(f"patch MCP: {msg}")
    err = kickstart()
    if err:
        problems.append(err)
    p = plugin_state() or {}
    if not plugin_ok(p.get("version"), core) and not (install and p.get("version") == install.rsplit("@", 1)[1]):
        problems.append(f"plugin whatsapp {p.get('version')}, atteso {core}")
    if install and not problems:
        notes.append(f"plugin whatsapp -> {install.rsplit('@', 1)[1]}")
    return problems, notes


def heartbeat():
    """Un heartbeat vero: modello, tool MCP (con la patch), sessioni. None = andato."""
    d = oc_json(["cron", "list", "--all", "--json"], 90) or {}
    job = next((j for j in d.get("jobs") or [] if j.get("name") == HEARTBEAT), None)
    if not job:
        return f"cron {HEARTBEAT} non trovato"
    t0 = time.time() * 1000 - 2000
    rc, out, err = oc(["cron", "run", job["id"], "--wait", "--wait-timeout", "8m"], 540)
    e = ((oc_json(["cron", "runs", job["id"], "--limit", "1", "--sort", "desc", "--json"], 90) or {})
         .get("entries") or [{}])[0]
    if float(e.get("ts") or 0) < t0:
        return f"heartbeat: nessun run nuovo (exit {rc} {tail(err or out)})"
    error = str(e.get("error") or "")
    if e.get("status") != "ok" and KNOWN_DELIVERY_BUG in error:
        # bug openclaw#153453 (~1 heartbeat su 4 il 30/09, anche su 2026.9.5): il turno e' girato,
        # e' fallita solo la consegna. Non dice niente sulla versione nuova: bocciarla qui la
        # riporterebbe indietro per un difetto che ha anche la vecchia.
        log("heartbeat: turno eseguito, consegna fallita per il bug noto #153453: non conta")
        return None
    if e.get("status") != "ok":
        return f"heartbeat: {e.get('status')} {error[:120]}"
    return None


def health_gate(expected, rec):
    """Problemi NUOVI rispetto alla fotografia di prima: uno gia' rotto non e' colpa dell'update."""
    before = set(rec.get("problems") or [])
    end = time.time() + SETTLE_S
    while True:
        problems = [x for x in live_problems(expected) if x not in before]
        if not problems or time.time() >= end:
            break
        time.sleep(min(POLL_S, 10))
    if problems:
        return problems
    rc, msg = mcp_lazy("check")
    if rc:
        problems.append(f"patch MCP: {msg}")
    hb = heartbeat()
    if hb:
        problems.append(hb)
    new = sorted(set(doctor_fails()) - set(rec.get("doctor") or []))
    if new:
        problems.append("agents-doctor: " + "; ".join(new)[:240])
    return problems


def run_update(target):
    """`openclaw update` verso target. Ritorna (exit, record del run, stderr)."""
    log(f"openclaw update --yes --json --tag {target}")
    rc, out, err = oc(["update", "--yes", "--json", "--tag", target, "--timeout", "1800"], 3 * 3600)
    res = parse_json(out) or {}
    if rc == 75:
        # consegnato a un helper gestito: l'esito vero arriva nello storico
        end = time.time() + 3600
        while time.time() < end and (oc_json(["update", "status", "--json"], 60) or {}).get("activeRun"):
            time.sleep(POLL_S)
    rec = res.get("run") if isinstance(res.get("run"), dict) else None
    if rec is None or rc == 75:
        rec = (oc_json(["update", "status", "--json"], 60) or {}).get("lastRun") or {}
    log(f"update: exit {rc}, stato {rec.get('status')} {rec.get('reason') or ''}".rstrip())
    return rc, rec, err


def run_reason(rec, err=""):
    parts = [rec.get("reason")] if rec.get("reason") else []
    for s in rec.get("steps") or []:
        for f in s.get("failureFacts") or []:
            parts.append((f.get("message") or "").splitlines()[0] if f.get("message") else "")
    if len(parts) < 2 and tail(err):
        parts.append(tail(err))
    return ": ".join(dict.fromkeys(x for x in parts if x))[:200] or "motivo non riportato"


def record(cur, root):
    dist = Path(root or "") / "dist"
    files = sorted(glob.glob(str(dist / "mcp-http.loopback-runtime-*.mjs")) + glob.glob(str(dist / "mcp-http.schema-*.mjs")))
    plugins = (oc_json(["plugins", "list", "--json"], 180) or {}).get("plugins") or []
    return {
        "ts": datetime.datetime.now().strftime("%Y%m%d-%H%M%S"),
        "version": cur,
        "root": root,
        "config_sha256": sha(CONFIG) if CONFIG.exists() else None,
        "dist_sha256": {Path(f).name: sha(f) for f in files},
        "plugins": {p["id"]: {"version": p.get("version"), "spec": (p.get("trust") or {}).get("installSpec")}
                    for p in plugins if p.get("origin") == "global"},
        "doctor": doctor_fails(),
        "problems": live_problems(cur),
    }


def backup(rec):
    """Database SQLite (quelli che una migrazione cambia) + openclaw.json. None = fatto."""
    d = BACKUPS / rec["ts"]
    d.mkdir(parents=True, exist_ok=True)
    os.chmod(BACKUPS, 0o700)
    agents = sorted(Path(p).parent.parent.name for p in glob.glob(str(OC_HOME / "agents/*/agent/openclaw-agent.sqlite")))
    for args in [["--global"]] + [["--agent", a] for a in agents]:
        rc, out, err = oc(["backup", "sqlite", "create", *args, "--repository", str(d), "--json"], 900)
        if rc:
            return f"backup sqlite {' '.join(args)}: {tail(err or out)}"
    if CONFIG.exists():
        shutil.copy2(CONFIG, d / "openclaw.json")
        os.chmod(d / "openclaw.json", 0o600)
    (d / "record.json").write_text(json.dumps(rec, indent=1, ensure_ascii=False))
    for old in sorted(x for x in BACKUPS.iterdir() if x.is_dir())[:-KEEP_BACKUPS]:
        run(["trash", str(old)], 120)
    log(f"backup: {d} ({', '.join(['global'] + agents)} + openclaw.json)")
    return None


def notify(text):
    job = oc_json(["cron", "get", BRIEF_CRON], 60) or {}
    d = job.get("delivery") or {}
    if not (d.get("channel") and d.get("to")):
        log(f"notifica NON inviata (destinatario non leggibile dal cron {BRIEF_CRON[:8]}): {text}")
        return
    rc, out, err = oc(["message", "send", "--channel", d["channel"], "--target", d["to"], "-m", text, "--json"], 120)
    log(f"notifica {'inviata' if rc == 0 else 'NON inviata (' + tail(err or out) + ')'}: {text}")


# ---------------------------------------------------------------- il giro

def rollback(old, rec):
    """Torna a `old`: prima la strada di OpenClaw (update --tag, con verifica), poi npm."""
    log(f"rollback a {old}")
    if wait_idle(min(POST_IDLE_MIN, 10)):
        log("rollback anche se OpenClaw non e' fermo: la versione nuova non ha passato i controlli")
    rc, run_rec, err = run_update(old)
    must = False
    if installed_version() != old:
        log(f"update --tag {old} non basta ({run_reason(run_rec, err)}): npm i -g openclaw@{old}")
        rc, out, err = run(["npm", "i", "-g", f"openclaw@{old}", "--allow-scripts=openclaw"], 1200)
        must = True  # il gateway in memoria e' ancora quello nuovo
    now = installed_version()
    if now != old:
        return [f"rollback: installata {now}, attesa {old}"]
    problems, notes = converge(old, min(POST_IDLE_MIN, 10), must_restart=must)
    problems = problems or health_gate(old, rec)
    root = (oc_json(["update", "status", "--json"], 60) or {}).get("update", {}).get("root") or rec.get("root")
    same = {Path(f).name: sha(f) for f in glob.glob(str(Path(root or "") / "dist/mcp-http.*.mjs"))
            if Path(f).name in rec.get("dist_sha256", {})} == rec.get("dist_sha256")
    log(f"rollback: dist patchato {'identico' if same else 'diverso'} da prima dell'update")
    return problems


def maintain(cur, root, dry, idle):
    """Nessuna versione nuova: patch MCP e plugin devono comunque essere a posto."""
    todo = []
    p = plugin_state()
    if p and not plugin_ok(p.get("version"), cur):
        todo.append(f"plugin whatsapp {p.get('version')} (core {cur})")
    rc, msg = mcp_lazy("check")
    if rc:
        todo.append(f"patch MCP: {msg}")
    if not todo:
        return 0
    log("da sistemare: " + "; ".join(todo))
    if dry:
        log("dry-run: non tocco niente")
        return 0
    rec = record(cur, root)
    problems, notes = converge(cur, idle)
    if problems and problems[0].startswith("OpenClaw mai fermo"):
        log(problems[0] + ": riprovo la notte prossima")
        return 0
    problems = problems or health_gate(cur, rec)
    if problems:
        notify(f"OpenClaw {short(cur)}: non riesco a sistemare {'; '.join(todo)}: {'; '.join(problems)}"[:300])
        return 1
    notify(f"OpenClaw {short(cur)}: sistemato {'; '.join(todo)}, tutto verde"[:300])
    return 0


def main():
    ap = argparse.ArgumentParser(description="Aggiorna OpenClaw a OpenClaw fermo, con rollback.")
    ap.add_argument("--dry-run", action="store_true", help="passi 1-3 senza toccare niente, poi il piano")
    ap.add_argument("--force-version", help="giro supervisionato verso questa versione (arma il notturno)")
    ap.add_argument("--idle-wait", type=float, default=45, help="minuti di attesa di OpenClaw fermo")
    a = ap.parse_args()

    LOCK.parent.mkdir(parents=True, exist_ok=True)
    lock = open(LOCK, "w")
    try:
        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except OSError:
        log("un altro giro e' in corso: esco")
        return 3

    gw = gateway_pid()
    if (gw and gw in ancestors()) or os.environ.get("OPENCLAW_GATEWAY_SERVICE_PID"):
        # e' esattamente il managed-service-preflight che ha fatto fallire l'auto-update:
        # dall'albero del gateway `openclaw update` non puo' fermare il gateway che lo contiene
        log(f"rifiuto: giro dentro il gateway di OpenClaw (pid {gw}); va lanciato da launchd o da un terminale")
        return 4

    state = load_state()
    armed = bool(state.get("armed"))
    dry = a.dry_run or not (armed or a.force_version)
    st = oc_json(["update", "status", "--json", "--timeout", "15"], 90)
    cur = installed_version()
    if not isinstance(st, dict) or not cur:
        log("OpenClaw non risponde a update status/--version: niente da fare stanotte")
        return 1
    root = (st.get("update") or {}).get("root")
    latest = (st.get("availability") or {}).get("latestVersion")
    target = a.force_version or latest
    if a.force_version and not re.fullmatch(VER_RE, target):
        log(f"--force-version {target}: non e' una versione")
        return 4
    if not target or vtuple(target) <= vtuple(cur):
        if a.force_version and vtuple(target) < vtuple(cur):
            log(f"--force-version {target} e' piu' vecchia di {cur}: per tornare indietro openclaw update --tag")
            return 4
        log(f"OpenClaw {cur}: nessuna versione nuova (ultima {latest})")
        return maintain(cur, root, dry, a.idle_wait)

    why_dry = " [dry-run]" if a.dry_run else " [non armato: il primo giro vero e' quello supervisionato]" if dry else ""
    log(f"OpenClaw {cur} -> {target}{why_dry}")
    busy = busy_reasons() if dry else wait_idle(a.idle_wait)
    if busy:
        log("OpenClaw non e' fermo: " + ", ".join(busy) + ("" if dry else "; riprovo la notte prossima"))
        if not dry:
            return 0
    rec = record(cur, root)
    log(f"fotografia: {cur}, openclaw.json {str(rec['config_sha256'])[:12]}, "
        + ", ".join(f"{k} {v[:12]}" for k, v in rec["dist_sha256"].items())
        + " | plugin " + ", ".join(f"{k} {v['version']}" for k, v in sorted(rec["plugins"].items()))
        + f" | agents-doctor FAIL {len(rec['doctor'])} | problemi gia' presenti {rec['problems'] or 'nessuno'}")
    if dry:
        wa = rec["plugins"].get(PLUGIN, {}).get("version")
        for step in (f"backup SQLite (global + agenti) e openclaw.json in {BACKUPS}/<ts>",
                     f"openclaw update --yes --json --tag {target} (validazione, riavvio e verifica di OpenClaw)",
                     f"plugin whatsapp {wa} -> {target} (se OpenClaw non lo allinea: plugins install --force --pin)",
                     "patch MCP: saltata se il fix upstream e' nel codice nuovo, se no openclaw-mcp-lazy.py apply",
                     "un kickstart -k a OpenClaw fermo, health gate (canali, WhatsApp, heartbeat, patch, agents-doctor)",
                     f"se qualcosa fallisce: rollback a {cur} e health gate; una riga su WhatsApp ad Attilio"):
            log("piano: " + step)
        return 0

    free = shutil.disk_usage(HOME).free / 1e9
    if free < MIN_FREE_GB:
        msg = f"aggiornamento OpenClaw {short(cur)}→{short(target)} non tentato: {free:.1f} GB liberi sul Mac"
        log(msg)
        notify(msg)
        return 4
    err = backup(rec)
    if err:
        msg = f"aggiornamento OpenClaw {short(cur)}→{short(target)} non tentato: {err}"
        log(msg)
        notify(msg[:300])
        return 1

    state["last"] = {"started": rec["ts"], "from": cur, "to": target}
    save_state(state)
    rc, run_rec, err = run_update(target)
    now = installed_version()
    if rc == 0 and now == target:
        problems, notes = converge(target, POST_IDLE_MIN)
        problems = problems or health_gate(target, rec)
        if not problems:
            state["last"].update(result="ok", notes=notes)
            if a.force_version and not armed:
                state.update(armed=True, armed_at=datetime.datetime.now().isoformat(timespec="seconds"))
                log("armato: da domani il giro notturno aggiorna da solo")
            save_state(state)
            log(f"aggiornato {cur} -> {target}, tutto verde {notes or ''}".rstrip())
            notify(f"OpenClaw aggiornato {short(cur)}→{short(target)}, tutto verde")
            return 0
        why = "; ".join(problems)
    elif now == cur:
        # OpenClaw non ha attivato la versione nuova, o e' tornato indietro da solo
        why = run_reason(run_rec, err)
        log(f"update non attivato ({run_rec.get('status')}): {why}")
        problems, _ = converge(cur, POST_IDLE_MIN)
        problems = problems or health_gate(cur, rec)
        state["last"].update(result="failed", why=why, after=problems)
        save_state(state)
        if problems:
            notify(f"aggiornamento OpenClaw fallito ({why}) e {short(cur)} non e' sana: {'; '.join(problems)}"[:300])
            return 2
        notify(f"aggiornamento OpenClaw fallito, tornato a {short(cur)}: {why}"[:300])
        return 1
    else:
        why = run_reason(run_rec, err) if rc else f"installata {now}, attesa {target}"
    log(f"fallito dopo l'update: {why}")
    problems = rollback(cur, rec)
    state["last"].update(result="rolled-back" if not problems else "rollback-failed", why=why, after=problems)
    save_state(state)
    if problems:
        now = installed_version()
        notify(f"aggiornamento OpenClaw fallito ({why}), rollback NON riuscito: {short(now)} installata, "
               f"{'; '.join(problems)}"[:300])
        return 2
    notify(f"aggiornamento OpenClaw fallito, tornato a {short(cur)}: {why}"[:300])
    return 1


if __name__ == "__main__":
    sys.exit(main())
