<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.jarvis.devreap</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/python3</string>
    <string>/Users/zorahrel/.claude/jarvis/scripts/devreap/devreap</string>
  </array>
  <!-- Ogni 5 min: tre passate = ~15 min prima che qualcosa venga raccolto,
       abbastanza perche' una pausa di lavoro non sembri un processo morto. -->
  <key>StartInterval</key>
  <integer>300</integer>
  <key>RunAtLoad</key>
  <false/>
  <key>Nice</key>
  <integer>5</integer>
  <key>LowPriorityIO</key>
  <true/>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/usr/bin:/bin:/usr/sbin:/sbin:/opt/homebrew/bin</string>
    <key>HOME</key>
    <string>/Users/zorahrel</string>
  </dict>
  <key>StandardOutPath</key>
  <string>/Users/zorahrel/.claude/jarvis/logs/devreap.out.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/zorahrel/.claude/jarvis/logs/devreap.err.log</string>
</dict>
</plist>
