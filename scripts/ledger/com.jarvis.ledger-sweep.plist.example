<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.jarvis.ledger-sweep</string>
  <key>ProgramArguments</key>
  <array>
    <string>/opt/homebrew/bin/python3</string>
    <string>/Users/zorahrel/.claude/jarvis/scripts/ledger/ledger.py</string>
    <string>sweep</string>
    <string>--days</string>
    <string>3</string>
  </array>
  <!-- Ogni 30 min: una sessione morta su quota o errore API diventa una card di ripresa
       sulla board del suo repo (o su inbox). ~3 s di scan, nessun LLM. -->
  <key>StartInterval</key>
  <integer>1800</integer>
  <key>RunAtLoad</key>
  <false/>
  <key>Nice</key>
  <integer>5</integer>
  <key>LowPriorityIO</key>
  <true/>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/usr/bin:/bin:/usr/sbin:/sbin:/opt/homebrew/bin</string>
    <key>HOME</key>
    <string>/Users/zorahrel</string>
  </dict>
  <key>StandardOutPath</key>
  <string>/Users/zorahrel/.claude/jarvis/logs/ledger-sweep.out.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/zorahrel/.claude/jarvis/logs/ledger-sweep.err.log</string>
</dict>
</plist>
