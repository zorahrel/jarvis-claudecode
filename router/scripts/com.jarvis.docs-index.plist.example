<?xml version="1.0" encoding="UTF-8"?>
<!--
  Example LaunchAgent for the docs-index HTTP server (document RAG, local).

  Install:
    sed "s|__HOME__|$HOME|g" com.jarvis.docs-index.plist.example \
      > ~/Library/LaunchAgents/com.jarvis.docs-index.plist
    launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.jarvis.docs-index.plist

  Runs in its own venv (router/scripts/docs-env): numpy, onnxruntime,
  tokenizers. Until 2026-09-28 it borrowed the OMEGA venv (omega-env).

  The label was com.jarvis.chroma until 2026-08-14: ChromaDB really did sit
  behind :3342 until docs-server.py replaced it on 2026-07-05, and the name
  outlived it. See docs/memory-consolidation.md.
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.jarvis.docs-index</string>

  <key>ProgramArguments</key>
  <array>
    <string>__HOME__/.claude/jarvis/router/scripts/docs-env/bin/python3</string>
    <string>-u</string>
    <string>__HOME__/.claude/jarvis/router/scripts/docs-server.py</string>
  </array>

  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>

  <key>StandardOutPath</key>
  <string>__HOME__/.claude/jarvis/logs/docs-index.log</string>
  <key>StandardErrorPath</key>
  <string>__HOME__/.claude/jarvis/logs/docs-index.err.log</string>

  <key>WorkingDirectory</key>
  <string>__HOME__/.claude/jarvis/router</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
  </dict>
</dict>
</plist>
